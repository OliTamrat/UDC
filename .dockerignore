# Dependencies — installed inside the image by the deps stage, never copied in.
# The bare pattern only matches the context root, so nested copies (notably
# azure-functions/node_modules) were being uploaded: the build context was
# 537MB, which made every ACR upload and local build crawl.
node_modules
**/node_modules

# Separate deployment artifact — the ingestion cron functions build and deploy
# on their own and are not referenced by the Next.js app. Its node_modules plus
# a 529MB deploy.zip were the bulk of the build context.
azure-functions
**/*.zip

# Build output — regenerated by the builder stage
.next
**/.next
out
dist

# Local tooling and VCS
.git
.github
.vscode
.idea
.venv
coverage
*.tsbuildinfo

# Docs — not needed at runtime
*.md
!README.md

# Secrets
.env*.local

# Local SQLite database — production uses DATABASE_URL (Postgres); the seed
# script recreates the file inside the image.
data/*.db
data/*.db-wal
data/*.db-shm
